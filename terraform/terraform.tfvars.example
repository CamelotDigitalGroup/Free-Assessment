# Copy this file to terraform.tfvars and adjust as needed.

# Optional — only needed if your `az login` session isn't already on the right tenant.
# tenant_id = "00000000-0000-0000-0000-000000000000"

# Display name for the app registration.
application_name = "M365 Security Assessment"

# Path to the PUBLIC certificate to upload (PEM/.cer, base64 encoded).
# Leave commented out to add the certificate manually in the portal later.
# certificate_path = "./M365SecurityAssessment.cer"

# "Global Reader" (default) or "Compliance Reader".
directory_role = "Global Reader"

# Grant the optional tenant-wide SharePoint sharing-settings permission.
include_optional_sharepoint_setting = true